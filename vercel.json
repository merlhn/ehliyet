{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://ehliyet-52d4d.firebaseapp.com/__/auth/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        }
      ]
    },
    {
      "source": "/((?!__/auth/).*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/deneme-sinavlari",
      "destination": "/ehliyet-sinav-sorulari/",
      "permanent": true
    },
    {
      "source": "/deneme-sinavlari/",
      "destination": "/ehliyet-sinav-sorulari/",
      "permanent": true
    },
    {
      "source": "/deneme-sinavlari/:path+",
      "destination": "/ehliyet-sinav-sorulari/",
      "permanent": true
    },
    {
      "source": "/cikmis-sorular",
      "destination": "/ehliyet-sinav-sorulari/",
      "permanent": true
    },
    {
      "source": "/cikmis-sorular/",
      "destination": "/ehliyet-sinav-sorulari/",
      "permanent": true
    },
    {
      "source": "/cikmis-sorular/:path+",
      "destination": "/ehliyet-sinav-sorulari/",
      "permanent": true
    },
    {
      "source": "/ehliyet-sorulari",
      "destination": "/ehliyet-sinav-sorulari/",
      "permanent": true
    },
    {
      "source": "/ehliyet-sorulari/",
      "destination": "/ehliyet-sinav-sorulari/",
      "permanent": true
    },
    {
      "source": "/ehliyet-sorulari/:path+",
      "destination": "/ehliyet-sinav-sorulari/",
      "permanent": true
    },
    {
      "source": "/hap-bilgiler/arac-teknigi/arac-muayene-suresi-dolmasa-blie-aracin-ozel-teknik-muayenesi",
      "destination": "/hap-bilgiler/arac-teknigi/muayene-suresi-dolmasa-bile-aracin-ozel-teknik-muayenesi/",
      "permanent": true
