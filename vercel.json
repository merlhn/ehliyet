{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/__/auth/:path*",
      "destination": "https://ehliyet-52d4d.firebaseapp.com/__/auth/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/deneme-sinavlari",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/deneme-sinavlari/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/deneme-sinavlari/:path+",
      "destination": "/",
      "permanent": false
    }
  ]
}
