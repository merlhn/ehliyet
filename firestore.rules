rules_version = '2';

// ehliyet.digital — Firestore güvenlik kuralları
//
// Temel ilke: kullanıcı yalnızca kendi verisine erişir ve YETKİ kayıtlarına
// hiçbir koşulda yazamaz. Yetki yazımı sadece sunucu tarafında (Vercel
// fonksiyonu + Firebase Admin SDK) yapılır; Admin SDK bu kuralları baypas eder.
// Bu ayrım olmazsa kullanıcı kendine ücretsiz sınav yetkisi yazabilir.

service cloud.firestore {
  match /databases/{database}/documents {

    function girisYapmis() {
      return request.auth != null;
    }

    function sahibi(uid) {
      return girisYapmis() && request.auth.uid == uid;
    }

    // ---- Profil ----
    // Kullanıcı kendi profilini okur ve günceller. Yalnızca beyaz listedeki
    // alanlar yazılabilir; ileride 'rol' veya 'premium' gibi bir alan eklenirse
    // istemcinin onu kendi kendine set etmesi engellenmiş olur.
    match /users/{uid} {
      allow read: if sahibi(uid);

      // E-posta yalnızca oluşturmada ve Google'dan gelen değerle yazılabilir;
      // güncellemede beyaz listede yok, yani kullanıcı kendi kimliğini
      // değiştiremez. Profildeki e-posta ile giriş yapılan hesap hep aynı kalır.
      allow create: if sahibi(uid)
        && request.resource.data.keys().hasOnly(
             ['email', 'ad', 'soyad', 'telefon', 'ehliyetTuru', 'fotoUrl', 'olusturulmaAt', 'sonGirisAt'])
        && request.resource.data.email == request.auth.token.email;

      allow update: if sahibi(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['ad', 'soyad', 'telefon', 'ehliyetTuru', 'fotoUrl', 'sonGirisAt']);

      allow delete: if false;

      // ---- Sınav denemeleri (sonuçlar) ----
      // Kullanıcı kendi denemesini oluşturur ve okur. Değiştiremez, silemez —
      // geçmiş kayıt sonradan düzeltilebilir olmamalı.
      //
      // NOT: puan istemcide hesaplanıp yazıldığı için teorik olarak sahte sonuç
      // yazılabilir. Bu veri kişisel ilerleme takibi olduğundan kabul edilebilir.
      // İleride sıralama/rozet gibi rekabetçi bir özellik gelirse puanlama
      // sunucuya taşınmalıdır.
      match /denemeler/{denemeId} {
        allow read:   if sahibi(uid);
        allow create: if sahibi(uid)
          && request.resource.data.sinav is string
          && request.resource.data.dogru is int
          && request.resource.data.yanlis is int
          && request.resource.data.bos is int
          && request.resource.data.puan is int
          && request.resource.data.gecti is bool
          && request.resource.data.bolumler is map;
        allow update, delete: if false;
      }

      // ---- Sınav yetkileri ----
      // Sadece okunur. Yazma yalnızca sunucu tarafında (Admin SDK) yapılır.
      match /yetkiler/{sinavId} {
        allow read: if sahibi(uid);
        allow write: if false;
      }
    }

    // ---- Geri bildirim ----
    // Herkes (girişsiz ziyaretçi dahil) geri bildirim BIRAKABİLİR ama kimse
    // okuyamaz; kayıtlar yalnızca Firebase konsolundan / Admin SDK ile okunur.
    // Girişsiz yazıma izin vermek spam riski taşır; alan beyaz listesi ve boyut
    // sınırları bu yüzden sıkı tutuluyor. Sorun olursa create girişe bağlanır.
    //
    // uid ya boştur (girişsiz ziyaretçi) ya da gönderenin kendisidir; başkasının
    // kimliğiyle geri bildirim yazılamaz. NOT: yorum satırı çok satırlı ifadenin
    // ortasına giremez — kural derleyicisi "Unexpected 'allow'" hatası verir.
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(
             ['mesaj', 'email', 'puan', 'sayfa', 'uid', 'olusturulmaAt'])
        && request.resource.data.mesaj is string
        && request.resource.data.mesaj.size() >= 1
        && request.resource.data.mesaj.size() <= 2000
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && (request.resource.data.puan == null
            || (request.resource.data.puan is int
                && request.resource.data.puan >= 1
                && request.resource.data.puan <= 5))
        && request.resource.data.sayfa is string
        && request.resource.data.sayfa.size() <= 300
        && (request.resource.data.uid == null
            || (girisYapmis() && request.resource.data.uid == request.auth.uid));
      allow read, update, delete: if false;
    }

    // Geri kalan her şey kapalı.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
